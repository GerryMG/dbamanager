# =====================================================================================
# DBA Manager (Quarkus) — configuración
# Copia este archivo a .env (en la carpeta desde donde ejecutas la app) y completa los valores.
# Las variables de entorno del sistema tienen prioridad sobre .env (en contenedores se pueden
# inyectar desde un secret).
# =====================================================================================

# ------------------------------------------------------------------ Aplicación
# Puerto donde escucha la app (API + interfaz web en el mismo puerto)
PORT=8080
# Nivel de log: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Dirección pública con la que los usuarios abren DBA Manager, p. ej. https://dbamanager.empresa.com
# Las llaves de seguridad de los DBAs quedan ligadas a este dominio. Debe ser HTTPS (o http://localhost
# para probar en tu máquina). Vacío = la dirección con la que llegue cada petición.
APP_PUBLIC_URL=
# IPs o redes de los proxies confiables (router/balanceador) para tomar la IP real del usuario y el
# esquema https de las cabeceras X-Forwarded-*. Separadas por coma. 127.0.0.1 = no confiar en nadie más
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------------ Seguridad
# Llave para cifrar las contraseñas de las conexiones guardadas y firmar respaldos y sesiones.
# 32 bytes en base64 url-safe. Generar con:
#   openssl rand -base64 32 | tr '+/' '-_'
# ¡Respáldala! Sin ella no se pueden descifrar las conexiones ni restaurar respaldos.
SECRETS_KEY=change_me
# Horas que dura la ejecución desde la app una vez que el DBA la activa para sí mismo (0 = no vence)
SELF_EXECUTION_HOURS=8
# Para registrar una llave de seguridad el DBA debe haber escrito su contraseña hace menos de estos minutos
REAUTH_MINUTES=10
# Esquemas adicionales que nunca pueden ser objeto de una solicitud, separados por coma.
# Siempre protegidos: los internos de Oracle, las cuentas de servicio y el usuario de la metadata
PROTECTED_SCHEMAS=
# Máximo de operaciones por solicitud
MAX_OPERATIONS=200
# Permitir restaurar un respaldo REEMPLAZANDO la metadata existente (borra solicitudes y bitácora actuales).
# false = solo se restaura sobre una metadata vacía
METADATA_RESTORE_REPLACE=false
# Tamaño máximo del archivo de respaldo a restaurar (MB)
RESTORE_MAX_MB=50

# ------------------------------------------------------------------ Metadata (Oracle 12.1+)
# Base donde DBA Manager guarda solicitudes, aprobaciones, llaves públicas, bitácora, conexiones, etc.
# Qué debe existir y con qué privilegios: docs/ORACLE.md. Las tablas se crean solas al arrancar.
# Formato: host:puerto/servicio. Para conexión cifrada (TLS): tcps://host:puerto/servicio
METADATA_DSN=oracle-metadata.empresa.com:1521/DBAMGRPDB
METADATA_USER=DBAMGR
DBAMGR_PASSWORD=change_me
# Conexiones simultáneas a la metadata
METADATA_POOL_SIZE=15

# ------------------------------------------------------------------ Keycloak (inicio de sesión)
# Guía paso a paso: docs/KEYCLOAK.md
# URL de Keycloak tal como la ve el NAVEGADOR del usuario (sin /realms/...)
KEYCLOAK_PUBLIC_URL=https://sso.empresa.com
# URL con la que el SERVIDOR de DBA Manager llega a Keycloak, si es distinta (red interna).
# Vacío = KEYCLOAK_PUBLIC_URL
KEYCLOAK_INTERNAL_URL=
# Realm donde están los usuarios
KEYCLOAK_REALM=dbamanager
# Client ID del cliente con el que inician sesión los usuarios (Standard flow + PKCE)
KEYCLOAK_CLIENT_ID=dbamanager-web
# Solo si el cliente es confidencial (Client authentication = On). Vacío = cliente público con PKCE
KEYCLOAK_CLIENT_SECRET=
# Audiencia que debe traer el token de acceso (normalmente el mismo KEYCLOAK_CLIENT_ID; requiere el
# "audience mapper" de docs/KEYCLOAK.md, paso 3). Vacío = no validar audiencia (menos seguro).
OIDC_AUDIENCE=dbamanager-web
# Solo si tu proveedor OIDC no sigue el formato de URLs de Keycloak: URL completa del emisor
OIDC_ISSUER_URL=

# ------------------------------------------------------------------ Roles de la app
# Dónde están los roles en Keycloak: realm (Realm roles) o client (roles del cliente KEYCLOAK_ROLES_CLIENT)
KEYCLOAK_ROLES_SOURCE=realm
# Cliente que tiene los roles cuando KEYCLOAK_ROLES_SOURCE=client. Vacío = KEYCLOAK_CLIENT_ID
KEYCLOAK_ROLES_CLIENT=
# Nombre en Keycloak de cada rol de la app (puedes usar los nombres que ya existan en tu Keycloak)
ROLE_REQUESTER=solicitante
ROLE_DBA=dba
ROLE_DBA_ADMIN=dba_admin
ROLE_ADMIN=admin

# ------------------------------------------------------------------ Asignar roles desde la app
#   token           = con el usuario de Keycloak del admin que inició sesión (necesita en
#                     realm-management: view-users, query-users y manage-users)
#   service-account = con un cliente confidencial (KEYCLOAK_ADMIN_CLIENT_ID / _SECRET) con esos roles
#   off             = deshabilitado; los roles se asignan en la consola de Keycloak
KEYCLOAK_ROLES_ADMIN_MODE=token
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ------------------------------------------------------------------ Datos de demostración
# true = si la metadata está vacía, crea conexiones a las bases demo (../demo/docker-compose.yml)
SEED_DEMO=false
SEED_ORACLE_HOST=localhost
SEED_ORACLE_PORT=1521
CATALOG_PASSWORD=
EXECUTOR_PASSWORD=
