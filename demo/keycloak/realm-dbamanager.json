{
  "realm": "${KEYCLOAK_REALM:dbamanager}",
  "displayName": "DBA Manager",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "en"
  ],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      {
        "name": "solicitante",
        "description": "Puede explorar estructuras y crear solicitudes"
      },
      {
        "name": "dba",
        "description": "DBA con alcance limitado a los esquemas que se le asignen en DBA Manager"
      },
      {
        "name": "dba_admin",
        "description": "DBA principal: aprueba y ejecuta cualquier solicitud"
      },
      {
        "name": "admin",
        "description": "Administra conexiones, proyectos, alcances y respaldos de metadata"
      }
    ]
  },
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID:dbamanager-web}",
      "name": "DBA Manager Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "*"
      },
      "protocolMappers": [
        {
          "name": "audience-dbamanager",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${KEYCLOAK_CLIENT_ID:dbamanager-web}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.dba",
      "email": "admin.dba@example.com",
      "firstName": "Carla",
      "lastName": "Principal",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Cambiar.123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "solicitante",
        "dba_admin",
        "admin"
      ],
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users"
        ]
      }
    },
    {
