# =====================================================================================
# DBA Manager — configuración
# Copia este archivo a .env y completa los valores. Las variables de entorno del sistema
# tienen prioridad sobre .env (útil en contenedores: se pueden inyectar desde un secret).
# Si un valor tiene caracteres especiales, escríbelo entre comillas dobles.
# =====================================================================================

# ------------------------------------------------------------------ Aplicación
# Puerto donde escucha la app (API + interfaz web en el mismo puerto)
PORT=8080
# Nivel de log: debug | info | warning | error
LOG_LEVEL=info
# Carpeta con la interfaz web compilada. Vacío = se detecta sola (frontend/dist en local, /app/static en la imagen)
STATIC_DIR=
# Orígenes permitidos para CORS, separados por coma. Solo hace falta si sirves la interfaz desde
# otro dominio (p. ej. el modo desarrollo de Vite: http://localhost:5173)
CORS_ORIGINS=

# ------------------------------------------------------------------ Seguridad
# Llave para cifrar las contraseñas de las conexiones guardadas en la metadata. Generar con:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ¡Respáldala! Sin ella no se pueden descifrar las conexiones ni restaurar respaldos.
SECRETS_KEY=change_me

# ------------------------------------------------------------------ Metadata (Oracle 12.1+)
# Base donde DBA Manager guarda solicitudes, aprobaciones, bitácora, conexiones, etc.
# Qué debe existir y con qué privilegios: docs/ORACLE.md (sección 1). Las tablas se crean solas al arrancar.
# Formato: host:puerto/servicio
METADATA_DSN=oracle-metadata.empresa.com:1521/DBAMGRPDB
METADATA_USER=DBAMGR
DBAMGR_PASSWORD=change_me
# Alternativa a las tres anteriores: URL completa de SQLAlchemy (tiene prioridad)
# METADATA_URL=oracle+oracledb://DBAMGR:clave@host:1521/?service_name=DBAMGRPDB
METADATA_URL=

# ------------------------------------------------------------------ Keycloak (inicio de sesión)
# Guía paso a paso de la configuración en Keycloak: docs/KEYCLOAK.md
# URL de Keycloak tal como la ve el NAVEGADOR del usuario (sin /realms/...). Debe coincidir con el
# "issuer" de los tokens: https://<KEYCLOAK_PUBLIC_URL>/realms/<KEYCLOAK_REALM>
KEYCLOAK_PUBLIC_URL=https://sso.empresa.com
# URL con la que el SERVIDOR de DBA Manager llega a Keycloak, si es distinta (red interna).
# Vacío = KEYCLOAK_PUBLIC_URL
KEYCLOAK_INTERNAL_URL=
# Realm donde están los usuarios
KEYCLOAK_REALM=dbamanager
# Client ID del cliente público (OpenID Connect, sin secreto) con el que inician sesión los usuarios
KEYCLOAK_CLIENT_ID=dbamanager-web
# Audiencia que debe traer el token (normalmente el mismo KEYCLOAK_CLIENT_ID; requiere el
# "audience mapper" de docs/KEYCLOAK.md, paso 3). Vacío = no validar audiencia (menos seguro).
OIDC_AUDIENCE=dbamanager-web
# Solo si tu proveedor OIDC no sigue el formato de URLs de Keycloak:
OIDC_ISSUER_URL=
OIDC_JWKS_URI=

# ------------------------------------------------------------------ Roles de la app
# Dónde están los roles en Keycloak:
#   realm  = roles del realm (Realm roles)
#   client = roles del cliente indicado en KEYCLOAK_ROLES_CLIENT (Clients → <cliente> → Roles);
#            útil si no tienes permiso para crear roles de realm
KEYCLOAK_ROLES_SOURCE=realm
# Cliente que tiene los roles cuando KEYCLOAK_ROLES_SOURCE=client. Vacío = KEYCLOAK_CLIENT_ID
KEYCLOAK_ROLES_CLIENT=
# Nombre en Keycloak de cada rol de la app (puedes usar los nombres que ya existan en tu Keycloak)
ROLE_REQUESTER=solicitante
ROLE_DBA=dba
ROLE_DBA_ADMIN=dba_admin
ROLE_ADMIN=admin

# ------------------------------------------------------------------ Asignar roles desde la app
# Cómo asigna roles la pantalla Administración → Usuarios y roles:
#   token           = con el usuario de Keycloak del admin que inició sesión (no requiere usuario
#                     master ni secreto; ese usuario necesita en realm-management: view-users,
#                     query-users y manage-users). Ver docs/KEYCLOAK.md
#   service-account = con un cliente confidencial (KEYCLOAK_ADMIN_CLIENT_ID / _SECRET) con esos roles
#   off             = deshabilitado; los roles se asignan en la consola de Keycloak
KEYCLOAK_ROLES_ADMIN_MODE=token
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ------------------------------------------------------------------ Datos de demostración
# true = si la metadata está vacía, crea conexiones a las bases demo (demo/docker-compose.yml)
SEED_DEMO=false
# Dónde está el Oracle de la demo y las contraseñas de sus cuentas de servicio
SEED_ORACLE_HOST=localhost
SEED_ORACLE_PORT=1521
CATALOG_PASSWORD=
EXECUTOR_PASSWORD=

# ------------------------------------------------------------------ Solo para demo/docker-compose.yml
# (infraestructura de prueba con Oracle y Keycloak; no las usa la aplicación)
ORACLE_PORT=1521
ORACLE_SYS_PASSWORD=
DEMO_PASSWORD=
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_PASSWORD=
