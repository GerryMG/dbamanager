# =====================================================================================
# DBA Manager — configuración. Por defecto TODO es externo: en este servidor solo corren
# el backend y el frontend; la metadata, Keycloak y las bases administradas están en sus
# propios servidores. (Para una demo local completa ver el bloque al final.)
# =====================================================================================

# Qué levanta docker compose en este servidor. Vacío = solo backend y frontend.
# Demo local: oracle-local,keycloak
COMPOSE_PROFILES=

# ---- Metadata de DBA Manager (Oracle 12.1+ externo) ----
# Crear el usuario con scripts/oracle/usuario_metadata.sql; las tablas las crea el backend al arrancar.
METADATA_DSN=oracle-metadata.empresa.com:1521/DBAMGRPDB
METADATA_USER=DBAMGR
DBAMGR_PASSWORD=change_me
# Alternativa: cualquier URL de SQLAlchemy (tiene prioridad sobre METADATA_DSN)
# METADATA_URL=oracle+oracledb://DBAMGR:clave@host:1521/?service_name=DBAMGRPDB

# ---- Keycloak / OIDC externo ----
# URL con la que el NAVEGADOR llega a Keycloak (también arma el "issuer" de los tokens)
KEYCLOAK_PUBLIC_URL=https://sso.empresa.com
# URL con la que el BACKEND llega a Keycloak. Vacío = KEYCLOAK_PUBLIC_URL
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=dbamanager
# Cliente público con el que inician sesión los usuarios (navegador)
KEYCLOAK_CLIENT_ID=dbamanager-web
# Opcionales para otros proveedores OIDC o URLs no estándar:
# OIDC_ISSUER_URL=https://sso.empresa.com/realms/corp
# OIDC_JWKS_URI=https://sso.empresa.com/realms/corp/protocol/openid-connect/certs
# Audiencia que debe traer el token (por defecto KEYCLOAK_CLIENT_ID; vacío = no validar)
# OIDC_AUDIENCE=
# Roles: "realm" (realm_access) o "client" (resource_access de KEYCLOAK_ROLES_CLIENT)
KEYCLOAK_ROLES_SOURCE=realm
# KEYCLOAK_ROLES_CLIENT=dbamanager-web
# Nombre en Keycloak de cada rol de la app
ROLE_REQUESTER=solicitante
ROLE_DBA=dba
ROLE_DBA_ADMIN=dba_admin
ROLE_ADMIN=admin
# Cuenta de servicio para asignar roles desde DBA Manager (scripts/keycloak/configurar_cliente_admin.sh).
# Vacío = roles solo desde la consola de Keycloak.
KEYCLOAK_ADMIN_CLIENT_ID=dbamanager-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me

# ---- Backend / frontend (lo que corre en este servidor) ----
BACKEND_PORT=8000
FRONTEND_PORT=8088
# Dónde encuentra el frontend (nginx) al backend; cambiar si el backend corre en otro servidor
# BACKEND_URL=http://backend:8000
# Llave Fernet para cifrar las contraseñas de las conexiones guardadas en la metadata.
# Generar con: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ¡Respáldala! Sin ella no se pueden descifrar las conexiones ni restaurar respaldos.
SECRETS_KEY=change_me
# Orígenes permitidos para CORS (solo si sirves el frontend en otro dominio, p. ej. Vite en desarrollo)
CORS_ORIGINS=
# Crea conexiones demo al Oracle local; solo para la demo
SEED_DEMO=false

# =====================================================================================
# Demo local completa (opcional): descomentar y usar COMPOSE_PROFILES=oracle-local,keycloak
# =====================================================================================
# METADATA_DSN=oracle:1521/FREEPDB1
# KEYCLOAK_PUBLIC_URL=http://IP-DE-ESTE-SERVIDOR:8180
# KEYCLOAK_INTERNAL_URL=http://keycloak:8180
# SEED_DEMO=true
# ORACLE_PORT=1521
# ORACLE_SYS_PASSWORD=change_me
# CATALOG_PASSWORD=change_me
# EXECUTOR_PASSWORD=change_me
# DEMO_PASSWORD=change_me
# KEYCLOAK_PORT=8180
# KEYCLOAK_ADMIN_PASSWORD=change_me
